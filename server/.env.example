# ===== 乡芽系统环境配置模板（复制为 .env 使用）=====
# 注意：本文件包含敏感信息，严禁提交到版本库

# 服务
NODE_ENV=production
PORT=3000
APP_URL=https://xiangya.example.com
# 允许的跨域来源（逗号分隔）
CORS_ORIGIN=https://xiangya.example.com
# 资源独立域名（文件上传后生成的访问地址前缀）
UPLOAD_PUBLIC_URL=https://files.xiangya.example.com

# 数据库（SQLite 文件路径，相对 server 目录或绝对路径）
DB_PATH=./data/xiangya.db
# 数据库自动同步实体结构（生产建议 false，使用 seed 建表）
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis（生产必配；本地开发可不装，自动降级为内存存储）
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 安全密钥（生产必须替换为强随机值：openssl rand -base64 48）
JWT_SECRET=please-change-me-to-a-random-256bit-secret-0123456789abcdef
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# 签名密钥（防重放/CSRF 相关，生产替换）
SIGNING_SECRET=please-change-me-signing-secret-0123456789abcdef

# 会话与安全参数
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=30
CAPTCHA_REQUIRED_AFTER_FAILURES=3
PASSWORD_MIN_LENGTH=10
# 单设备模式：true 时新登录自动踢掉旧会话
SINGLE_DEVICE_MODE=false

# LLM 适配层（留空 = Demo 规则引擎模式，零成本；填入后启用真实生成）
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# OCR 适配层（留空 = Demo 模拟）
OCR_PROVIDER=demo
OCR_API_KEY=

# 管理员初始账号（仅 seed 时使用，生产务必立即修改密码）
SEED_ADMIN_USERNAME=zhoujuzhang
SEED_ADMIN_PASSWORD=Admin@2026Xy
